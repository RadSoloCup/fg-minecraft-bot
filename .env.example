# ── Minecraft -> Fluxer ──────────────────────────────────────────────────────
# Path to the server's log file, as seen INSIDE this container (bind-mount it
# read-only from the Minecraft server's appdata/logs directory).
MC_LOG_PATH=/mc-logs/latest.log

# Webhook for the target Fluxer channel (channel settings -> Integrations ->
# Webhooks -> New Webhook). Chat lines post here as the player's own name.
FLUXER_WEBHOOK_URL=https://chat.example.com/api/webhooks/xxxx/yyyy

# ── Fluxer -> Minecraft (optional) ──────────────────────────────────────────
# Leave FLUXER_BOT_TOKEN unset to run one-way (MC chat -> Fluxer only).
# To relay the other direction too: create a bot application in Fluxer, invite
# it to the server with View Channels + Read Message History, and set:
#FLUXER_BOT_TOKEN=
#FLUXER_CHANNEL_ID=          # the mc-game-chat channel id — only this channel is relayed
#FLUXER_API_BASE=https://chat.example.com   # defaults to the webhook's origin

# ── !mc commands (list/where/seed/time/tps/recipe/map) ─────────────────────
# Needs RCON either way — commands typed in-game (`!mc list`) work off RCON
# alone, no bot token required. The bot token above is only needed to also
# accept commands typed in Fluxer (and, via Crosstalk, Discord).
#COMMAND_PREFIX=!mc

# Names allowed to run `!mc map` (comma-separated, case-insensitive, matched
# against either the Minecraft player name or the Fluxer/Discord name).
# Empty = nobody can run it.
#ADMIN_NAMES=RadSoloCup

# RCON on the Minecraft server container (server.properties: enable-rcon=true).
#RCON_HOST=FTB-Direwolf20-1.20   # container name, reachable if both share a Docker network
#RCON_PORT=25575
#RCON_PASSWORD=

# World save directory (for `!mc map`), as seen INSIDE this container —
# bind-mount it read-only from the server's world save. Overworld only.
#WORLD_DIR=/world
